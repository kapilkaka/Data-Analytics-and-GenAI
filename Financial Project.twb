    <worksheet name='Inflation-Adjusted Transaction Amounts'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontsize='14'>Inflation-Adjusted Transaction Amounts </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cc_data' name='federated.1y737nx0hghbef1d8ca3u0lvx71h' />
          </datasources>
          <datasource-dependencies datasource='federated.1y737nx0hghbef1d8ca3u0lvx71h'>
            <column caption='Inflation-Adjusted Transaction Amounts' datatype='real' name='[Calculation_1324902743905185792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amt] * (1 + 0.02) ^ (YEAR(TODAY()) - YEAR([trans_date_trans_time]))' />
            </column>
            <column caption='Amt' datatype='real' name='[amt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1324902743905185792]' derivation='Sum' name='[sum:Calculation_1324902743905185792:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amt]' derivation='Sum' name='[sum:amt:qk]' pivot='key' type='quantitative' />
            <column caption='Trans Date Trans Time' datatype='datetime' name='[trans_date_trans_time]' role='dimension' type='ordinal' />
            <column-instance column='[trans_date_trans_time]' derivation='Week-Trunc' name='[twk:trans_date_trans_time:qk]' pivot='key' type='quantitative' />
